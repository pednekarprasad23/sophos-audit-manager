# Sophos Audit Manager Environment Configuration
# Copy this file to .env and update values

# Database Configuration
DB_HOST=db
DB_PORT=3306
DB_USER=audit_user
DB_PASSWORD=audit_user_pass_2024
DB_NAME=sophos_audit

# Session Configuration
SESSION_SECRET=your-very-secret-session-key-change-this-in-production

# Encryption Key for Password Manager (AES-256)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=default-encryption-key-change-in-production

# Node Environment
NODE_ENV=production

# Port (default 80 inside container, mapped to 9005 on host)
PORT=80